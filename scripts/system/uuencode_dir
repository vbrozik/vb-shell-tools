#!/bin/bash

# uuencode_dir

# Create a compressed tar archive of the current directory, encode it to text.
# The archive can be extracted using `base64 -d | tar -xJf -`

# The aim is to be able to move the directory content over clipboard.

# TODO:
# - Rename the script. Candidates: textpack


dir_base=$(basename "$(pwd)")

# --- The compression options for tar:
# Higher xz compression:
compress_option='-Ixz -8 -e'
# Standard xz compression:
# compress_option='-J'

# Decoding from text and extracting the content:
extract_command="base64 -d | tar -xJf -"
test_extract_command="base64 -d | tar -tJf -"
# extract_command="python3 -c 'import base64, sys; sys.stdout.buffer.write(base64.a85decode(sys.stdin.buffer.read()))' | tar -xJf -  # Press Ctrl+d at the end."

extract_comment="Press Ctrl+d at the end."


# Show usage information
usage() {
    echo "Create a tar archive and encode it in base64."
    echo "Extract the content using '$extract_command'"
    echo
    echo "Usage: $0 [-t] [-c] [-e] [-h] [dir_base]"
    echo
    echo "  dir_base  The base name of the directory to archive (default: current directory)"
    echo "  -t  Test mode: create a tar and list its contents"
    echo "  -c  Clipboard mode: put the encoded tar in the clipboard (WSL or Windows only)"
    echo "  -e  Include extract command in the output (for copy-paste convenience)"
    echo "  -h  Show this help message"
}

while getopts "thce" opt ; do
    case $opt in
        t)
            # test mode: create a tar and immediately list its contents
            test_mode=1
            ;;
        c)
            # clipboard mode: create a tar and copy it to the clipboard
            clipboard_mode=1
            ;;
        e)
            # include extract command in the output
            include_extract_command=1
            ;;
        h)
            # help mode: show usage information
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: -$opt" >&2
            usage
            exit 1
            ;;
    esac
done
shift $((OPTIND - 1))

explicit_dir_base=
if [ "$#" -eq 1 ] ; then
    dir_base="$1"
    explicit_dir_base=1
elif [ "$#" -gt 1 ] ; then
    echo "See $0 -h for usage. Unexpected number of arguments: $#" >&2
    exit 1  
fi

exclude_list=$(cat <<+++EOF+++
__pycache__
*.egg-info
$dir_base/.git
$dir_base/.vscode
$dir_base/.github
$dir_base/.venv
$dir_base/.pytest_cache
$dir_base/build
$dir_base/tmp
+++EOF+++
)


encode () {
    base64
    # python3 -c "import base64, sys; sys.stdout.write(base64.a85encode(sys.stdin.buffer.read()).decode('ascii'))"
}


postprocess () {
    if [ "$test_mode" = 1 ] ; then
        tee >(wc -c > "$tmp_len_counter") |
        eval "$test_extract_command" || {
            echo "Failed to extract the tar archive." >&2
            exit 1
        }
    else
        {
            if [ "$include_extract_command" = 1 ] ; then
                printf "%s  # %s\n" "$extract_command" "$extract_comment"
            fi
            cat
        } | 
        tee >(wc -c > "$tmp_len_counter") |
        {
            if [ "$clipboard_mode" = 1 ] && grep -qi 'wsl2' /proc/version >/dev/null 2>&1 ; then
                clip.exe
            else
                cat
            fi
        }
    fi
}


if [ "$explicit_dir_base" = 1 ] ; then
    if [ ! -d "$dir_base" ] ; then
        echo "Directory $dir_base does not exist." >&2
        exit 1
    fi
else
    cd .. || {
        echo "Failed to change directory to parent." >&2
        exit 1
    }
fi

tmp_len_counter=$(mktemp)
trap 'rm -f "$tmp_len_counter"' EXIT

tar -c "$compress_option" -f- --exclude-vcs-ignores --exclude-from <(printf "%s\n" "$exclude_list") "$dir_base" |
    encode |
    tmp_len_counter="$tmp_len_counter" postprocess

printf '\nLength of the encoded output: %s bytes\n' "$(cat "$tmp_len_counter")"
